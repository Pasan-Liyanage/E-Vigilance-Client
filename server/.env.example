# ---------- Server ----------
PORT=5050
NODE_ENV=development
# Comma separated list of allowed browser origins (the PWA dev + preview servers)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173

# ---------- JWT ----------
JWT_SECRET=<CHOOSE_A_LONG_RANDOM_SECRET>
JWT_EXPIRES_IN=7d

# ---------- MongoDB Atlas ----------
# The database comes from the URI path, e.g. ...mongodb.net/evigilence?appName=...
# Set MONGO_DB_NAME to override it.
MONGO_URI=<GET_MONGODB_CONNECTION_STRING_PRIVATELY>

# ---------- Media storage ----------
# r2     = upload to Cloudflare R2 (requires the R2_* keys below)
# gridfs = store media in MongoDB GridFS and serve it from this API (works with no extra accounts)
# auto   = use R2 when the keys are present, otherwise GridFS
STORAGE_DRIVER=auto
MAX_UPLOAD_MB=50

# ---------- Cloudflare R2 ----------
# Files go to <R2_BUCKET>/<R2_PREFIX>/images|videos|audios/
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=e-vigilance
R2_PREFIX=evidence
