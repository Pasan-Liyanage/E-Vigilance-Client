# ---------- Server ----------
PORT=5050
NODE_ENV=development
# Comma separated list of allowed browser origins (the PWA dev + preview servers)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173

# ---------- JWT ----------
JWT_SECRET=<CHOOSE_A_LONG_RANDOM_SECRET>
JWT_EXPIRES_IN=7d

# ---------- MongoDB Atlas ----------
# The database comes from the URI path, e.g. ...mongodb.net/evigilence?appName=...
# Set MONGO_DB_NAME to override it. It must be the same database the admin
# system uses (its MONGODB_DB_NAME): the two share report, update and reward
# collections (ADMIN-SYSTEM-GAPS.md §6).
MONGO_URI=<GET_MONGODB_CONNECTION_STRING_PRIVATELY>

# ---------- Text messages (phone verification codes) ----------
# console = development only: codes are written to the server log
# demo    = demonstrations: nothing is sent; the app shows the code, marked as demo
#           mode (DEMO.md). Never where real citizens sign up
# none    = off (the default in production until a provider is added)
SMS_PROVIDER=console

# ---------- Evidence links ----------
# public = anyone with a media link can open it (keep while the previous
#          admin panel still shows evidence straight from these links)
# signed = only links signed for the report's owner (valid one hour), and
#          the admin system's import, which sends MEDIA_SERVICE_KEY
MEDIA_ACCESS=public
# Signs owners' links; defaults to JWT_SECRET when empty.
MEDIA_SIGNING_SECRET=
# Shared with the admin system (its APP_MEDIA_KEY). Generate a long random value.
MEDIA_SERVICE_KEY=

# ---------- Media storage ----------
# r2     = upload to Cloudflare R2 (requires the R2_* keys below)
# gridfs = store media in MongoDB GridFS and serve it from this API (works with no extra accounts)
# auto   = use R2 when the keys are present, otherwise GridFS
STORAGE_DRIVER=auto
MAX_UPLOAD_MB=50

# ---------- Cloudflare R2 ----------
# Files go to <R2_BUCKET>/<R2_PREFIX>/images|videos|audios/
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=e-vigilance
R2_PREFIX=evidence
