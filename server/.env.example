# ---------- Server ----------
PORT=5050
NODE_ENV=development
# Comma separated list of allowed browser origins (the PWA dev + preview servers)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173

# ---------- JWT ----------
JWT_SECRET=<CHOOSE_A_LONG_RANDOM_SECRET>
JWT_EXPIRES_IN=7d

# ---------- MongoDB Atlas (shared with the admin panel) ----------
MONGO_URI=<GET_MONGODB_CONNECTION_STRING_PRIVATELY>

# ---------- Media storage ----------
# gridfs  = store media in MongoDB GridFS and serve it from this API (works with no extra accounts)
# cloudinary = upload to Cloudinary (requires the three keys below)
# auto    = use Cloudinary when the keys are present, otherwise GridFS
STORAGE_DRIVER=auto
MAX_UPLOAD_MB=50

# ---------- Cloudinary (optional - fill in to switch media to Cloudinary) ----------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=evigilance/violations
