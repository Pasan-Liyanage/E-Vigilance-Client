# Leave empty to use the Vite dev proxy (recommended for local work).
# Set to the API origin when the PWA is hosted separately, e.g.
# VITE_API_URL=https://api.example.com
VITE_API_URL=

# Media uploads need no build-time settings: the browser asks the API for a
# signed Cloudflare R2 URL and uploads straight to the bucket. The R2 keys
# live only on the server - see server/.env.example.
