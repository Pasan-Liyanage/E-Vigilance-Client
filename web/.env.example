# Leave empty to use the Vite dev proxy (recommended for local work).
# Set to the API origin when the PWA is hosted separately, e.g.
# VITE_API_URL=https://api.example.com
VITE_API_URL=

# ---------------------------------------------------------------------------
# Direct-to-Cloudinary uploads
#
# Required on serverless hosts (Vercel caps request bodies at 4.5MB, well under
# a phone video). When both values are set, the browser uploads evidence
# straight to Cloudinary and the API receives only the resulting URLs.
#
# Create an *unsigned* upload preset: Cloudinary dashboard -> Settings ->
# Upload -> Upload presets -> Add unsigned preset. No API secret is needed, so
# nothing sensitive ends up in the bundle.
#
# Leave both empty to keep uploading through the API into MongoDB GridFS.
# ---------------------------------------------------------------------------
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
VITE_CLOUDINARY_FOLDER=evigilance/violations
