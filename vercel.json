{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm --prefix server ci --omit=dev && npm --prefix web ci",
  "buildCommand": "npm --prefix web run build",
  "outputDirectory": "web/dist",
  "framework": null,
  "regions": ["sin1"],
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
